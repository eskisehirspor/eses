# Copy values into the app-specific example files. Never put the service-role key in mobile or admin public env.

# --- Mobile (apps/mobile/.env) ---
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_AUTH_APPLE_ENABLED=false
# EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false

# --- Admin (apps/admin/.env.local) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server / Edge Functions / CI only ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
